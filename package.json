{
  "name": "sellerscope",
  "private": true,
  "version": "0.1.0",
  "description": "SEO & growth studio for Etsy sellers: listing SEO analyzer, shop stats & traffic diagnostics, seller-type profiles, a 7-day study course and an AI advisor.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --ignore ./src --ignore ./dist server/index.ts",
    "build": "tsc -p . && vite build",
    "start": "tsx server/index.ts --production",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval-compare.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
